{
  "name": "page-color-prop",
  "version": "1.2.6",
  "description": "Colors note backgrounds based on frontmatter properties.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run --coverage",
    "build": "npm run check && npm test && npm run bundle",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "typecheck": "tsc -noEmit -skipLibCheck",
    "check": "npm run lint && npm run typecheck",
    "bundle": "node esbuild.config.mjs production"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "properties",
    "color",
    "background"
  ],
  "author": "notuntoward",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "@vitest/coverage-v8": "^5.1.0",
    "builtin-modules": "3.3.0",
    "commons": "file:../obsidian-commons",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "obsidian": "~1.14.4",
    "tslib": "2.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.1",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "vite": {
      "esbuild": "^0.28.1"
    }
  }
}
