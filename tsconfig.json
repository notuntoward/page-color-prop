{
  "compilerOptions": {
    "baseUrl": ".",
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "ESNext",
    "target": "ES6",
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "noImplicitAny": true,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "isolatedModules": true,
    "strictNullChecks": true,
    "lib": [
      "DOM",
      "ES6"
    ],
    "paths": {
      "obsidian": [
        "./node_modules/obsidian"
      ],
      "commons/*": [
        "../obsidian-commons/src/*/index.ts"
      ],
      "commons/internals": [
        "../obsidian-commons/src/internals.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "*.mts"
  ]
}
